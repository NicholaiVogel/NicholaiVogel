---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/media/Lightbox.astro';
import { displayTags, formatDate, readingTime, slugFor, type WritingEntry } from '../../lib/writing';

export async function getStaticPaths() {
  const entries = await getCollection('writing');
  return entries.map((entry) => ({
    params: { slug: slugFor(entry) },
    props: { entry },
  }));
}

function headingId(value: string, seen: Map<string, number>) {
  const base = value
    .toLowerCase()
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-');
  const count = seen.get(base) ?? 0;
  seen.set(base, count + 1);
  return count === 0 ? base : `${base}-${count + 1}`;
}

const { entry } = Astro.props as { entry: WritingEntry };
const { Content } = await render(entry);
const title = entry.data.title;
const heroImage = entry.data.image;
const displayTagList = displayTags(entry.data.tags);
const description = entry.data.description ?? `Writing by Nicholai Vogel: ${title}`;
const seenHeadingIds = new Map<string, number>();
const headings = [...entry.body.matchAll(/^(#{2,3})\s+(.+)$/gm)].map((match) => {
  const text = match[2].replace(/\s+#+\s*$/, '').trim();
  return { depth: match[1].length, id: headingId(text, seenHeadingIds), text };
});
---
<BaseLayout title={`${title} - Nicholai`} description={description}>
  <article class="article-shell container">
    <header class="article-header">
      <a class="back-link" href="/"><span class="back-link__arrow" aria-hidden="true">&larr;</span> All writing</a>
      <ul class="article-tags">
        {displayTagList.map((tag) => <li>{tag}</li>)}
      </ul>
      <h1>{title}</h1>
      <div class="article-meta">
        <time datetime={entry.data.created?.toISOString()}>{formatDate(entry)}</time>
        <span aria-hidden="true">/</span>
        <span>{readingTime(entry.body)}</span>
      </div>
      {heroImage && (
        <figure class="article-hero">
          <Image
            src={heroImage}
            alt={title}
            widths={[640, 960, 1280, 1920]}
            sizes="100vw"
            quality={82}
            loading="eager"
          />
        </figure>
      )}
    </header>

    <div class="article-layout">
      <div class="prose article-content">
        <Content />
      </div>
      <aside class="article-aside">
        {headings.length > 0 && (
          <nav class="article-toc" aria-label="On this page">
            <p class="article-toc__label">On this page</p>
            <ol>
              {headings.map((heading) => (
                <li class:list={[{ 'article-toc__subitem': heading.depth === 3 }]}>
                  <a href={`#${heading.id}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )}
        <a class="article-top-link" href="#main-content">Back to top ↑</a>
      </aside>
    </div>
  </article>
  <Lightbox />
</BaseLayout>
