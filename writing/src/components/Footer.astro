---
import { SOCIAL_LINKS } from '../consts';
import BrandIcon from './BrandIcon.astro';
---
<footer class="site-footer">
  <div class="container footer-inner">
    <p>Writing by Nicholai Vogel.</p>
    <nav aria-label="External links" class="footer-links">
      {SOCIAL_LINKS.slice(0, 4).map((link) => (
        <a class="footer-link" href={link.href} target="_blank" rel="noreferrer" aria-label={link.label} title={link.label}>
          <BrandIcon name={link.label} />
          <span class="sr-only">{link.label}</span>
        </a>
      ))}
      <a class="footer-link" href="/rss.xml" aria-label="RSS" title="RSS">
        <BrandIcon name="RSS" />
        <span class="sr-only">RSS</span>
      </a>
    </nav>
  </div>
</footer>
