---
import { displayTags, formatDate, readingTime, slugFor, type WritingEntry } from '../lib/writing';

interface Props {
  entry: WritingEntry;
  featured?: boolean;
}

const { entry } = Astro.props;
const tags = displayTags(entry.data.tags);
---
<article class="writing-row" data-writing-card data-tags={entry.data.tags.join('|').toLowerCase()}>
  <div class="writing-row__date">
    <time datetime={entry.data.created?.toISOString()}>{formatDate(entry)}</time>
    <span>{readingTime(entry.body)}</span>
  </div>
  <div class="writing-row__content">
    <h2><a href={`/writing/${slugFor(entry)}/`}>{entry.data.title}</a></h2>
    <ul class="writing-row__tags" aria-label="Tags">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
  <a class="writing-row__arrow" href={`/writing/${slugFor(entry)}/`} aria-label={`Read ${entry.data.title}`}>↗</a>
</article>
