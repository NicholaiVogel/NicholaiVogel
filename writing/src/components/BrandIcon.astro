---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === 'X' && (
    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.657l-5.214-6.817-5.963 6.817H1.684l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117l11.966 15.644Z" />
  )}
  {name === 'Instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4.25" />
      <circle class="brand-icon__dot" cx="17.35" cy="6.7" r="1.1" />
    </>
  )}
  {name === 'LinkedIn' && (
    <>
      <path d="M5.2 8.6H2.1V21h3.1V8.6ZM3.65 3A1.8 1.8 0 1 0 3.65 6.6 1.8 1.8 0 0 0 3.65 3ZM8.8 8.6H5.85V21h3.1v-6.14c0-1.62.3-3.19 2.32-3.19 1.99 0 2.02 1.86 2.02 3.3V21h3.1v-6.68c0-3.28-.7-5.8-4.48-5.8-1.82 0-3.04 1-3.54 1.95h-.04V8.6Z" />
    </>
  )}
  {name === 'GitHub' && (
    <path d="M12 .3a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.04c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.75.08-.74.08-.74 1.2.08 1.84 1.23 1.84 1.23 1.07 1.83 2.8 1.3 3.48.99.11-.77.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.94 0-1.31.47-2.38 1.23-3.22-.12-.3-.53-1.52.12-3.17 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.3-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.87.12 3.17.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.63-5.48 5.93.43.37.81 1.1.81 2.22v3.28c0 .32.22.7.83.58A12 12 0 0 0 12 .3Z" />
  )}
  {name === 'RSS' && (
    <>
      <circle class="brand-icon__dot" cx="5.2" cy="18.8" r="1.8" />
      <path d="M3.4 10.3a10.3 10.3 0 0 1 10.3 10.3M3.4 4.2a16.4 16.4 0 0 1 16.4 16.4" />
    </>
  )}
</svg>
