---
import { ARTICLE_IMAGE_SIZES, responsiveImage, type ImageInput } from '../../lib/images';

interface Props {
  src: ImageInput;
  alt: string;
  width?: number;
  height?: number;
  caption?: string;
  imgClass?: string;
  sizes?: string;
}

const { src, alt, caption, imgClass = '', sizes = ARTICLE_IMAGE_SIZES } = Astro.props;
const image = await responsiveImage(src);
const width = Astro.props.width ?? image.width;
const height = Astro.props.height ?? image.height;
---
<figure class="media-figure">
  <img
    src={image.src}
    srcset={image.srcset}
    sizes={image.srcset ? sizes : undefined}
    alt={alt}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
    class:list={['w-full h-auto border border-white/10', imgClass]}
  />
  {caption && <figcaption class="media-caption">{caption}</figcaption>}
</figure>
