const igUrl = (handle: string) => `https://www.instagram.com/${handle}/`;
const isList = (v: string | CreditPerson[]): v is CreditPerson[] => Array.isArray(v);
---

<div class="film-credits">
  {sections.map((section) => (
    <section class="film-credits__block">
      {section.heading && <h3 class="film-credits__heading">{section.heading}</h3>}
      <dl class="film-credits__roles">
        {section.roles.map(({ role, people }) => (
          <div class="film-credits__row">
            <dt class="film-credits__role">{role}</dt>
            <dd class="film-credits__names">
              {isList(people) && people.map((person) => (
                person.ig ? (
                  <a href={igUrl(person.ig)} target="_blank" rel="noopener noreferrer">{person.name}</a>
                ) : (
                  <span>{person.name}</span>
                )
              ))}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  ))}
</div>
